# Used by docker-compose.yml. Copy to .env (which is git-ignored) and fill in the two secrets.
#
# JWT_SECRET: at least 32 characters.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# TOTP_ENC_KEY: exactly 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENC_KEY=

# Optional: summary generation via OpenRouter. Leave the key empty and summaries are simply off.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Comma-separated, tried in order after OPENROUTER_MODEL
OPENROUTER_FALLBACK_MODELS=
