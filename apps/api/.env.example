# Runtime
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# Database (Neon): pooled for the app, direct for migrations
DATABASE_URL=
DIRECT_URL=
DATABASE_URL_TEST=

# Auth
JWT_SECRET=
JWT_ISSUER=travel-photo-journal
JWT_AUDIENCE=travel-photo-journal-web
TOTP_ENC_KEY=

# Mail (SMTP): Mailpit locally
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Travel Photo Journal <no-reply@localhost>"

# Storage: "local" for dev/tests, "r2" for production
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Summary generation (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODELS=
