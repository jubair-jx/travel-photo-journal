# Runtime
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
LOG_LEVEL=info
# Reverse proxies in front of the API (1 on Railway), for correct client IPs
TRUST_PROXY=0

# Database (Neon): pooled for the app, direct for migrations
DATABASE_URL=
DIRECT_URL=
# Local compose Postgres: postgresql://tpj:tpj@localhost:5432/tpj_test
DATABASE_URL_TEST=

# Auth
# At least 32 characters; generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ISSUER=travel-photo-journal
JWT_AUDIENCE=travel-photo-journal-web
# Path the browser sees for /auth routes; use /api/auth behind the web proxy
REFRESH_COOKIE_PATH=/
# 32 random bytes, base64; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOTP_ENC_KEY=

# Mail. Production: set RESEND_API_KEY to send over HTTPS (hosts such as Render's free tier block SMTP
# ports). MAIL_FROM must then be an address on a domain verified in Resend.
RESEND_API_KEY=
# Mail (SMTP): Mailpit locally
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Travel Photo Journal <no-reply@localhost>"

# Storage: "local" for development and tests, "s3" for any S3-compatible bucket (Neon Object Storage, R2, AWS)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./uploads
# Where browsers reach this API (local driver builds image links from it). Behind the web proxy: http://localhost:3000/api
API_PUBLIC_URL=http://localhost:4000
SIGNED_URL_TTL_SECONDS=900
# Required only when STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Neon requires path-style addressing
S3_FORCE_PATH_STYLE=true

# Summary generation. Anthropic is used when its key is set; the default model is the cheapest one
# (about $0.00004 per summary). With no key at all, summaries are switched off.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Alternative provider, used only when ANTHROPIC_API_KEY is empty.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Comma-separated, tried in order after OPENROUTER_MODEL
OPENROUTER_FALLBACK_MODELS=
